    int sub3= marks3;

    if(total1>=40 && sub1>=33){
         if(total>=40 && sub2>=33){
            if(total>=40 && sub3>=33){
                printf("You Are Passed");
            }

        }
    }
    
    else
    printf("You Are Failed");
